---
name: verification-before-completion
description: Use when about to claim work is complete, fixed, or passing, before committing or creating PRs - requires running verification commands and confirming output before making any success claims; evidence before assertions always
---

# Verification Before Completion

## Overview

Claiming work is complete without verification is dishonesty, not efficiency.

**Core principle:** Evidence before claims, always.

**Violating the letter of this rule is violating the spirit of this rule.**

## The Iron Law

```
NO COMPLETION CLAIMS WITHOUT FRESH VERIFICATION EVIDENCE
```

If you haven't run the verification command in this message, you cannot claim it passes.

## The Gate Function

```
BEFORE claiming any status or expressing satisfaction:

1. IDENTIFY: What command proves this claim?
2. RUN: Execute the FULL command (fresh, complete)
3. READ: Full output, check exit code, count failures
4. VERIFY: Does output confirm the claim?
   - If NO: State actual status with evidence
   - If YES: State claim WITH evidence
5. ONLY THEN: Make the claim

Skip any step = lying, not verifying
```

## Common Failures

| Claim | Requires | Not Sufficient |
|-------|----------|----------------|
| Tests pass | Test command output: 0 failures | Previous run, "should pass" |
| Linter clean | Linter output: 0 errors | Partial check, extrapolation |
| Build succeeds | Build command: exit 0 | Linter passing, logs look good |
| Bug fixed | Test original symptom: passes | Code changed, assumed fixed |
| Regression test works | Red-green cycle verified | Test passes once |
| Agent completed | VCS diff shows changes | Agent reports "success" |
| Requirements met | Line-by-line checklist | Tests passing |

## Red Flags - STOP

- Using "should", "probably", "seems to"
- Expressing satisfaction before verification ("Great!", "Perfect!", "Done!", etc.)
- About to commit/push/PR without verification
- Trusting agent success reports
- Relying on partial verification
- Thinking "just this once"
- Tired and wanting work over
- **ANY wording implying success without having run verification**

## Rationalization Prevention

| Excuse | Reality |
import type { Layer } from '../state/editor'
import { initialEditorState, type EditorState } from '../state/editor'
import { requestImageData } from '../lib/http'
import { validateDocument, validateMetadata } from './projectValidation'

export const PROJECT_FORMAT = 'draivio'
export const PROJECT_SCHEMA_VERSION = 2

export type ProjectMetadata = { id: string; name: string; updatedAt?: string }
export type ProjectDocument = Partial<EditorState> & { documentWidth: number; documentHeight: number; layers: EditorState['layers'] }
type ProjectState = EditorState | ProjectDocument
type ProjectFile = { format: typeof PROJECT_FORMAT; schemaVersion: number; metadata: ProjectMetadata; assets: Record<string, string>; document: ProjectDocument }
type FetchAsset = (url: string) => Promise<string>

function clone<T>(value: T): T {
  return JSON.parse(JSON.stringify(value, (key, child) => /^(apiKey|api_key|authorization|accessToken|refreshToken|password|credentials|secret)$/i.test(key) ? undefined : child)) as T
}

function isRemoteSource(value: unknown): value is string {
  return typeof value === 'string' && /^https?:\/\//i.test(value)
}

const defaultFetchAsset: FetchAsset = requestImageData

function serializableDocument(state: ProjectState): ProjectDocument {
  const document = clone(state) as Partial<EditorState> & Record<string, unknown>
  delete document.activeTool
  delete document.activeToolGroup
  delete document.activeToolId
  delete document.recentToolByGroup
  delete document.toolOptions
  delete document.inspectorTab
  delete document.zoom
  delete document.selectedHistoryId
  delete document.historyTab
  delete document.historyCollapsed
  delete document.isGenerating
  delete document.composerPlacement
  delete document.composerMinimized
  delete document.notice
  delete document.brushColor
  delete document.recentColors
  delete document.canvasRotation
  delete document.canvasOffset
  delete document.undoStack
  delete document.redoStack
  delete document.apiKey
  if (Array.isArray(document.history)) document.history = document.history.map(({ id, label, tone }) => ({ id, label, tone }))
  const keys = ['documentWidth', 'documentHeight', 'documentBackground', 'layers', 'selectedLayerId', 'selectedLayerIds', 'aiResults', 'brushStrokes', 'canvasTexts', 'canvasShapes', 'layerMasks', 'selection', 'selectionRect', 'selectionVisible', 'cropRect', 'sceneOrder', 'prompt', 'composerMode', 'composerSourceId', 'composerParameters', 'history']
  return Object.fromEntries(keys.filter(key => key in document).map(key => [key, document[key]])) as ProjectDocument
}

/** Resource paths are part of the schema, never inferred from arbitrary strings. */
function imageFields(document: ProjectDocument) {
  type ResourceObject = { source?: string; thumbnail?: string; sourceImage?: string }
  type ResourceKey = keyof ResourceObject
  const fields: { item: ResourceObject; key: ResourceKey }[] = []
  const add = (item: ResourceObject | undefined, keys: ResourceKey[]) => {
    if (!item) return
    for (const key of keys) if (item[key] !== undefined) {
      if (typeof item[key] !== 'string') throw new Error('项目图片资源字段无效')
      fields.push({ item, key })
    }

function SceneLayer({ layer, state, strokePreview, shapePreview, transformPreview, maskPreview, children }: CanvasSceneProps & { layer: Layer; children?: ReactNode }) {
  const id = `layer-mask-${useId().replaceAll(':', '')}`
  const width = layer.contentWidth ?? state.documentWidth, height = layer.contentHeight ?? state.documentHeight
  const transform = transformPreview?.layerId === layer.id ? transformPreview.draft : layer.transform
  const mask = layer.id === state.selectedLayerId && maskPreview ? maskPreview : state.layerMasks[layer.id]
  const strokes = [...state.brushStrokes, ...(strokePreview ? [strokePreview] : [])].filter((stroke) => stroke.layerId === layer.id)
  const shapes = [...state.canvasShapes, ...(shapePreview ? [shapePreview] : [])].filter((shape) => shape.layerId === layer.id)
  const objects = [
    ...shapes.map((shape) => ({ id: shape.id, node: <Shape key={shape.id} shape={shape} width={width} height={height} /> })),
    ...state.canvasTexts.filter((object) => object.layerId === layer.id).map((object) => ({ id: object.id, node: <SceneText key={object.id} object={object} width={width} height={height} /> })),
  ]
  const base = layer.source === 'fixture' ? <g transform={`scale(${width / 500} ${height / 625})`}><CanvasFixtureContent /></g> : layer.source ? <image href={layer.source} width={width} height={height} preserveAspectRatio="xMidYMid meet" /> : null
  const order = [...state.sceneOrder, ...(strokePreview ? [strokePreview.id] : []), ...(shapePreview ? [shapePreview.id] : [])]
  const adjustments = layer.adjustmentsEnabled === false ? undefined : layer.adjustments
  const filterId = `${id}-adjustments`
  const filter = adjustmentPipeline(adjustments) ? `url(#${filterId})` : undefined
  return <g className="scene-layer" data-layer-id={layer.id} opacity={layer.opacity / 100} filter={filter} style={{ mixBlendMode: blends[layer.blendMode] ?? 'normal', isolation: children ? 'isolate' : undefined }}>
    <defs><AdjustmentFilter id={filterId} adjustments={adjustments} width={state.documentWidth} height={state.documentHeight} /></defs>
    <g data-layer-transform={layer.id} transform={layerTransformValue(transform, state.documentWidth, state.documentHeight, width, height)}>
      <defs>{mask?.applied ? MaskDefinitions(mask, id, width, height) : null}</defs>
      <g data-layer-mask={layer.id} mask={mask?.applied ? `url(#${id})` : undefined}>
        <BrushScene strokes={strokes} baseByLayer={{ [layer.id]: base }} objectsByLayer={{ [layer.id]: objects }} order={order} width={width} height={height} />
        {children}
      </g>
    </g>
  </g>
import { describe, expect, it } from 'vitest'
import { initialEditorState, type Layer } from '../state/editor'
import { encodeProject, decodeProject, projectFingerprint } from './projectFormat'

const png = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAYAAABytg0kAAAAEklEQVR4nGP4z8DwHwyBNBgAAEnICff5q7YNAAAAAElFTkSuQmCC'
const state = () => ({ ...structuredClone(initialEditorState),
  layers: [{ id: 'photo', name: '照片', className: 'layer-art', source: png, thumbnail: png, visible: true, opacity: 100, blendMode: '正常' }],
  selectedLayerId: 'photo', selectedLayerIds: ['photo'],
  canvasTexts: [{ id: 'text-a', layerId: 'photo', x: 10, y: 20, text: '可编辑文字', fontSize: 24, fontFamily: 'sans-serif', fontWeight: '400', color: '#112233', align: 'left' as const }],
})

describe('Draivio project files', () => {
  it('round trips editable objects and embeds deduplicated image resources', async () => {
    const input = state()
    const file = await encodeProject(input, { id: 'doc-1', name: '作品' })
    const raw = JSON.parse(file)
    expect(Object.keys(raw.assets)).toHaveLength(1)
    expect(raw.document.layers[0].source).toMatch(/^asset:/)
    const restored = decodeProject(file)
    expect(restored.metadata.name).toBe('作品')
    expect(restored.document.layers).toEqual(input.layers)
    expect(restored.document.canvasTexts).toEqual(input.canvasTexts)
    expect(restored.document.selectedLayerId).toBe('photo')
  })
  it('does not serialize preferences, credentials, in-flight jobs or history stacks', async () => {
    const input = { ...state(), apiKey: 'never-save-this', undoStack: [{ apiKey: 'secret-history' }], isGenerating: true }
    const raw = await encodeProject(input as never, { id: 'doc-1', name: '作品' })
    expect(raw).not.toContain('never-save-this')
    expect(raw).not.toContain('secret-history')
    expect(JSON.parse(raw).document).not.toHaveProperty('isGenerating')
  })
  it('rejects missing resources, broken references, corrupt files and future schema', async () => {
    const raw = JSON.parse(await encodeProject(state(), { id: 'd', name: 'p' }))
    expect(() => decodeProject('{')).toThrow(/无法读取/)
    expect(() => decodeProject(JSON.stringify({ ...raw, schemaVersion: 999 }))).toThrow(/新版本/)
    expect(() => decodeProject(JSON.stringify({ ...raw, assets: {} }))).toThrow(/资源/)
    raw.document.layers.push({ ...raw.document.layers[0] })
