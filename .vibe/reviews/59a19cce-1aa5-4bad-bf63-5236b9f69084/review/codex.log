   134	async function downloadBlob(blob:Blob,filename:string) {
   135	  const url=URL.createObjectURL(blob)
   136	  try {const link=document.createElement('a');link.href=url;link.download=filename;link.click(); await new Promise(resolve=>setTimeout(resolve,120))}
   137	  finally {setTimeout(()=>URL.revokeObjectURL(url),1000)}
   138	}

