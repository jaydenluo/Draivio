  if (match[1] === 'gif') return length > 13 && /^GIF8[79]a/.test(bytes) && bytes.endsWith(';')
  if (match[1] === 'webp') return length > 20 && bytes.startsWith('RIFF') && bytes.slice(8, 12) === 'WEBP'
