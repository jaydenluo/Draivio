  const discard = async () => {
    if (!confirmDiscard) return
    setBusy(true)
    try { scheduler.current?.invalidate(confirmDiscard); await store.discard(confirmDiscard); setSnapshots(rows => rows.filter(row => row.documentId !== confirmDiscard)); setConfirmDiscard(undefined); message.info('已丢弃恢复副本，手动项目未受影响') }
    catch (reason) { const text = reason instanceof Error ? reason.message : '丢弃失败，请重试'; setError(text); message.error(text) }
    finally { setBusy(false) }
  }
  const close = useCallback(() => { restoreGeneration.current++; setBusy(false); setOpen(false) }, [])
  const documents = [...new Map(snapshots.map(row => [row.documentId, snapshots.find(item => item.documentId === row.documentId)!])).values()]
  return <div className="recovery-control">
    <button aria-label="自动保存与恢复" onClick={() => { setOpen(true); void reload(true) }}>{enabled ? status : '自动保存已关闭'}</button>
    {error ? <button aria-label="重试自动保存" onClick={() => scheduler.current?.retry()}>重试</button> : null}
    {open ? <SettingsDialog label="自动保存与恢复" onClose={close}><header><strong>自动保存与恢复</strong><button aria-label="关闭自动保存与恢复" onClick={close}>×</button></header>
      <div className="recovery-content"><label className="recovery-preference"><input type="checkbox" aria-label="启用自动保存" checked={enabled} onChange={event => { const value = event.target.checked; setEnabled(value); scheduler.current?.setEnabled(value); try { localStorage.setItem(PREFERENCE, String(value)) } catch { message.warning('无法保存自动保存偏好') } }} />自动保存恢复副本</label><small>停止输入后保存，持续编辑最多每15秒保存；每个作品保留5个版本。</small>
      {error || readError ? <p role="alert">{error || readError}</p> : null}
      {!documents.length ? <p>没有待恢复的作品</p> : documents.map(row => <div className="recovery-row" key={row.documentId}>{row.preview ? <img src={row.preview} alt={`${row.name ?? '作品'}恢复预览`} /> : <span className="recovery-placeholder" aria-hidden="true">图</span>}<span><strong>{row.name ?? '未命名作品'}</strong><small>{new Date(row.savedAt).toLocaleString()} · {snapshots.filter(item => item.documentId === row.documentId).length}个版本</small></span><button disabled={busy} onClick={() => void restore(row.documentId)}>恢复副本</button><button disabled={busy} onClick={() => setConfirmDiscard(row.documentId)}>丢弃</button></div>)}
      {confirmDiscard ? <div className="recovery-confirm" role="alertdialog" aria-label="确认丢弃恢复副本"><p>丢弃该作品的所有恢复副本？手动保存的文件不受影响。</p><button disabled={busy} onClick={() => setConfirmDiscard(undefined)}>取消丢弃</button><button disabled={busy} onClick={() => void discard()}>确认丢弃</button></div> : null}
      </div><footer><span>{enabled ? status : '自动保存已关闭'}</span><button onClick={() => { scheduler.current?.retry(); void reload(true) }}>重新读取与重试</button><button onClick={close}>关闭</button></footer>
    </SettingsDialog> : null}
  </div>
}

--- Scheduler ---
import type { RecoveryStore, RecoverySnapshot } from './recoveryStore'
type Job = { documentId: string; sessionId: string; fingerprint: string; encode: () => Promise<RecoverySnapshot> }
/** One encoder at a time; continuous typing replaces only the pending job, never starves an active snapshot. */
export function createRecoveryScheduler(store: RecoveryStore, onStatus: (status: 'saving' | 'saved' | 'error', error?: string) => void, debounce = 900, maxWait = 15000) {
  let pending: Job | undefined, active: Job | undefined, lastSaved = '', identity = '', enabled = true
  let timer: ReturnType<typeof setTimeout> | undefined, periodic: ReturnType<typeof setTimeout> | undefined
  const clear = () => { clearTimeout(timer); clearTimeout(periodic); timer = periodic = undefined }
  const invalidateActive = () => { if (active) store.invalidate(active.documentId); active = undefined }
  const flush = async () => {
    if (active) return
    clear()
    const job = pending
    if (!enabled || !job) return
    pending = undefined; active = job
    const token = store.reserve(job.documentId)
    onStatus('saving')
    try {
      const snapshot = await job.encode()
      if (!enabled || active !== job) return
      if (await store.save(snapshot, token) && active === job) {
        lastSaved = job.fingerprint; active = undefined
        if (pending) {
          // Timers may already have fired while encoding was in progress. Reset both
          // handles so subsequent typing cannot postpone the next checkpoint forever.
          clear(); timer = setTimeout(() => void flush(), debounce); periodic = setTimeout(() => void flush(), maxWait)
        }
        else onStatus('saved')
      }
    } catch (error) {
      if (enabled && active === job) { active = undefined; pending ??= job; clear(); onStatus('error', error instanceof Error ? error.message : '恢复副本保存失败') }
    }
  }
  return {
    update(job: Job) {
      if (!enabled) return
      const nextIdentity = `${job.documentId}\0${job.sessionId}`
      if (identity !== nextIdentity) { invalidateActive(); if (pending) store.invalidate(pending.documentId); pending = undefined; clear(); lastSaved = ''; identity = nextIdentity }
      if (job.fingerprint === lastSaved) { invalidateActive(); pending = undefined; clear(); return }
      if (job.fingerprint === active?.fingerprint) { pending = undefined; clear(); return }
      if (job.fingerprint === pending?.fingerprint) return
      pending = job; clearTimeout(timer); timer = setTimeout(() => void flush(), debounce)
      if (!periodic) periodic = setTimeout(() => void flush(), maxWait)
    },
    retry: () => void flush(),
    setEnabled(value: boolean) { enabled = value; if (!value) { clear(); invalidateActive(); if (pending) store.invalidate(pending.documentId); pending = undefined; lastSaved = '' } },
    invalidate(documentId: string) { store.invalidate(documentId); if (pending?.documentId === documentId) { pending = undefined; clear() } if (active?.documentId === documentId) active = undefined; lastSaved = '' },
    dispose() { enabled = false; clear(); invalidateActive(); if (pending) store.invalidate(pending.documentId); pending = undefined },
  }
}

