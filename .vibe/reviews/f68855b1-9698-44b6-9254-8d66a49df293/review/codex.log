      if(!active())return
      try {localStorage.setItem(STORAGE_KEY,JSON.stringify(settings))} catch {/* Export succeeds even when preferences cannot be stored. */}
      downloadBlob(blob,`draivio-${settings.range}.${settings.format}`)
