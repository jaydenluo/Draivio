     3	/** One encoder at a time; continuous typing replaces only the pending job, never starves an active snapshot. */
     4	export function createRecoveryScheduler(store: RecoveryStore, onStatus: (status: 'saving' | 'saved' | 'error', error?: string) => void, debounce = 900, maxWait = 15000) {
     5	  let pending: Job | undefined, active: Job | undefined, lastSaved = '', identity = '', enabled = true
     6	  let timer: ReturnType<typeof setTimeout> | undefined, periodic: ReturnType<typeof setTimeout> | undefined
     7	  const clear = () => { clearTimeout(timer); clearTimeout(periodic); timer = periodic = undefined }
     8	  const invalidateActive = () => { if (active) store.invalidate(active.documentId); active = undefined }
     9	  const flush = async () => {
    10	    if (active) return
    11	    clear()
    12	    const job = pending
    13	    if (!enabled || !job) return
    14	    pending = undefined; active = job
    15	    const token = store.reserve(job.documentId)
    16	    onStatus('saving')
    17	    try {
    18	      const snapshot = await job.encode()
    19	      if (!enabled || active !== job) return
    20	      if (await store.save(snapshot, token) && active === job) {
    21	        lastSaved = job.fingerprint; active = undefined
    22	        if (pending) {
    23	          // Timers may already have fired while encoding was in progress. Reset both
    24	          // handles so subsequent typing cannot postpone the next checkpoint forever.
    25	          clear(); timer = setTimeout(() => void flush(), debounce); periodic = setTimeout(() => void flush(), maxWait)
    26	        }
    27	        else onStatus('saved')
    28	      }
    29	    } catch (error) {
    30	      if (enabled && active === job) { active = undefined; pending ??= job; clear(); onStatus('error', error instanceof Error ? error.message : '恢复副本保存失败') }
    31	    }
    32	  }
    33	  return {
    34	    update(job: Job) {
    35	      if (!enabled) return
    36	      const nextIdentity = `${job.documentId}\0${job.sessionId}`
    37	      if (identity !== nextIdentity) { invalidateActive(); if (pending) store.invalidate(pending.documentId); pending = undefined; clear(); lastSaved = ''; identity = nextIdentity }
    38	      if (job.fingerprint === lastSaved) { invalidateActive(); pending = undefined; clear(); return }
    39	      if (job.fingerprint === active?.fingerprint) { pending = undefined; clear(); return }
    40	      if (job.fingerprint === pending?.fingerprint) return
    41	      pending = job; clearTimeout(timer); timer = setTimeout(() => void flush(), debounce)
    42	      if (!periodic) periodic = setTimeout(() => void flush(), maxWait)
    43	    },
    44	    retry: () => void flush(),
    45	    setEnabled(value: boolean) { enabled = value; if (!value) { clear(); invalidateActive(); if (pending) store.invalidate(pending.documentId); pending = undefined; lastSaved = '' } },
    46	    invalidate(documentId: string) { store.invalidate(documentId); if (pending?.documentId === documentId) { pending = undefined; clear() } if (active?.documentId === documentId) active = undefined; lastSaved = '' },
