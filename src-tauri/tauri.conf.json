{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Draivio AI 图片创作",
  "version": "0.1.0",
  "identifier": "com.draivio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1440,
        "height": 900,
        "minWidth": 1020,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0d1013"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGM0U3MzJDMTM1OUMyRDIKUldUU3dsa1RMSE0rbjZ0WS9iNm5zNGxGQlJldURpbUdoMjcvdmk5MHNTLzRNek13dXRwcHFxcnQK",
      "endpoints": [
        "https://github.com/jaydenluo/Draivio/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
